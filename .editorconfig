# Editor settings for every file; shfmt reads the [*.sh] section.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.go]
indent_style = tab

[Makefile]
indent_style = tab

[*.md]
trim_trailing_whitespace = false

[*.sh]
shell_variant = bash
binary_next_line = true
switch_case_indent = true

[images/worker/rootfs/usr/local/bin/idea-{claude-subagent,dsh,entrypoint,runner}]
shell_variant = bash
binary_next_line = true
switch_case_indent = true

[images/worker/rootfs/usr/local/bin/idea-pr]
shell_variant = posix
binary_next_line = true
switch_case_indent = true
