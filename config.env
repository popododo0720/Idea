# Non-secret settings of the development host: where test VMs boot the ISO
# (a dedicated libvirt NAT network, idea-net) and the local registry.

LIBVIRT_NETWORK=idea-net
LIBVIRT_BRIDGE=idea-br0
NETWORK_CIDR=192.168.123.0/24
GATEWAY_IP=192.168.123.1
DHCP_RANGE_START=192.168.123.100
DHCP_RANGE_END=192.168.123.200

# Talos resolves through these (idea-net serves DHCP only, no DNS).
NAMESERVERS="1.1.1.1 8.8.8.8"

CLUSTER_NAME=idea
REGISTRY_ADDR=192.168.123.1:5000

# Where published images live. Manifests name images by this address. On the
# dev network the nodes mirror ghcr.io to the local registry first, so the same
# names resolve to what was built on this host (LOCAL_REPO).
IMAGE_REPO=ghcr.io/popododo0720
SOURCE_URL=https://github.com/popododo0720/Idea
LOCAL_REPO=192.168.123.1:5000/popododo0720

# Name the ingress certificate is issued for. HTTPS clients must use this name
# (SNI); plain https://<node IP>/ is not served. Example:
#   curl -k --resolve idea.internal:443:<machine address> https://idea.internal/git/
INGRESS_HOST=idea.internal

# Namespaces that receive the human-provided secrets (scripts/apply-secrets.sh).
SECRET_NAMESPACES="idea-work idea-system"
