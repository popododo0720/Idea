#!/bin/bash
# Start the desktop (Xvnc + XFCE), noVNC and sshd as the unprivileged user.
#
# IDEA_PATH_PREFIX  optional URL prefix the pod is published under, e.g.
#                   "/vm/w1". noVNC is then served at <prefix>/ so an ingress
#                   that cannot rewrite paths still works.
# IDEA_GEOMETRY     desktop size, default 1440x900.
set -euo pipefail

RUN=/tmp/idea
mkdir -p "$RUN/ssh" "$RUN/log"
chmod 700 "$RUN" "$RUN/ssh"

# SSH host key: generated per container, never part of the image.
[ -f "$RUN/ssh/ssh_host_ed25519_key" ] \
  || ssh-keygen -q -t ed25519 -N '' -f "$RUN/ssh/ssh_host_ed25519_key"

# noVNC web root, placed under the URL prefix.
prefix="${IDEA_PATH_PREFIX:-}"
prefix="${prefix#/}"; prefix="${prefix%/}"
rm -rf "$RUN/web"
web="$RUN/web${prefix:+/$prefix}"
mkdir -p "$web"
for f in /usr/share/novnc/*; do
  ln -s "$f" "$web/$(basename "$f")"
done
ws_path="${prefix:+$prefix/}websockify"
cat > "$web/index.html" <<HTML
<!doctype html>
<meta charset="utf-8">
<meta http-equiv="refresh" content="0; url=vnc.html?autoconnect=1&resize=remote&path=${ws_path}">
<title>idea worker</title>
HTML

# SSH sessions start with an empty environment. Keep what a remote dsh run
# needs (model keys, display) in a file only this user can read; it lives in
# the running pod, never in the image.
umask 077
{
  for v in DEEPSEEK_API_KEY CLAUDE_CODE_OAUTH_TOKEN DSH_TELEMETRY_MODE DISPLAY \
           $(compgen -v | grep -E '^(FORGEJO_|IDEA_)' || true); do
    if [ -n "${!v:-}" ]; then printf 'export %s=%q\n' "$v" "${!v}"; fi
  done
  printf 'export PATH=%q\n' "$PATH"
} > "$RUN/env"
umask 022

# Optional Claude Code subagent: installed now, from the npm registry, only
# when this pod was given a token. A failure leaves the pod working without it.
if [ -n "${CLAUDE_CODE_OAUTH_TOKEN:-}" ]; then
  timeout 180 /usr/local/bin/idea-claude-subagent > "$RUN/log/claude-subagent.log" 2>&1 \
    || echo "idea-entrypoint: Claude Code subagent not installed (see $RUN/log/claude-subagent.log)" >&2
fi

export IDEA_GEOMETRY="${IDEA_GEOMETRY:-1440x900}"
exec /usr/bin/supervisord -n -c /etc/idea/supervisord.conf
