#!/bin/bash
# Run the machine's agent dsh: the web profile, served over TLS on the pod
# address. Projects are dsh workspaces under $STATE/projects; sessions and
# settings (model keys added in the dsh UI) live in $STATE/dsh. $STATE is the
# persistent volume.
#
# Environment:
#   POD_IP            address to bind (downward API)
#   DSH_PORT          listen port, default 4443
#   DSH_TRUSTED_HOST  the authority clients use (Host header), e.g. the Service name
#   FORGEJO_API, FORGEJO_TOKEN, FORGEJO_USER   the in-cluster Forgejo
# The launch URL dsh prints (with its one-time-per-process token) is how the
# idea controller signs in; it goes to the pod log only.
set -euo pipefail

: "${POD_IP:?POD_IP is not set}"
STATE="${IDEA_STATE:-/home/idea/state}"
export DSH_HOME="$STATE/dsh"
mkdir -p "$DSH_HOME" "$STATE/projects"

# Git: identity, and credentials for Forgejo read at use time from the
# mounted Secret (dsh does not pass *TOKEN* variables on to the shells its
# agents run, so the environment alone does not reach git there). The token
# is never copied anywhere else.
git config --global user.name "${FORGEJO_USER:-idea-worker}"
git config --global user.email "${FORGEJO_USER:-idea-worker}@idea.internal"
git config --global init.defaultBranch main
git config --global credential.helper \
  '!f() { test "$1" = get || exit 0; echo "username=${FORGEJO_USER:-idea-worker}"; t=$(cat /etc/idea/forgejo/token 2>/dev/null || printf %s "$FORGEJO_TOKEN"); echo "password=$t"; }; f'

tls=()
if [ -f /etc/idea/tls/tls.crt ] && [ -f /etc/idea/tls/tls.key ]; then
  tls=(--tls-cert /etc/idea/tls/tls.crt --tls-key /etc/idea/tls/tls.key)
fi
trusted=()
if [ -n "${DSH_TRUSTED_HOST:-}" ]; then
  trusted=(--trusted-host "$DSH_TRUSTED_HOST")
fi

# Plugins from npm, installed into the profile (on the persistent volume) at
# the version pinned in the image; pnpm checks the registry integrity. A failed
# install leaves dsh running without that plugin.
#   - dsh-plugin-subscriptions: subscription models (Claude, ChatGPT/Codex,
#     Grok, Copilot, Antigravity), the same plugin the owner signs in with on
#     their own dsh; the idea plugin there keeps the sign-ins in step.
#   - dsh-pstack: skills, roles and the "Poteto mode" agent preset.
installed() {
  grep -q "\"$1\": \"$2\"" "$DSH_HOME/profiles/web/package.json" 2>/dev/null
}
ensure_plugin() {
  [ -n "$2" ] || return 0
  installed "$1" "$2" && return 0
  dsh plugin --profile web add --save-exact "$1@$2" \
    || echo "idea-dsh: could not install $1" >&2
}
ensure_plugin dsh-plugin-subscriptions "${IDEA_SUBSCRIPTIONS_PLUGIN_VERSION:-}"
ensure_plugin dsh-pstack "${IDEA_PSTACK_PLUGIN_VERSION:-}"

# Poteto mode is the default preset, but only when its plugin is there.
patches=(--patch /etc/idea/dsh/web.patch.yml)
if [ -n "${IDEA_PSTACK_PLUGIN_VERSION:-}" ] && installed dsh-pstack "$IDEA_PSTACK_PLUGIN_VERSION"; then
  patches+=(--patch /etc/idea/dsh/pstack.patch.yml)
fi

# Instructions for the agents (managed, kept up to date unless the owner took
# the file over by removing the managed first line). The main dsh (not a
# worker VM, which pulls its models from it) plans work as issues that worker
# VMs run in parallel.
agents="$DSH_HOME/AGENTS.md"
which=worker
[ -z "${IDEA_SYNC_SOURCE:-}" ] && which=orchestrator
if [ ! -e "$agents" ] || head -1 "$agents" | grep -q '^<!-- idea: managed'; then
  cp "/etc/idea/dsh/$which-AGENTS.md" "$agents"
fi

cd "$STATE/projects"
exec dsh --profile web "${patches[@]}" \
  --no-open --host "$POD_IP" --port "${DSH_PORT:-4443}" "${trusted[@]}" "${tls[@]}"
