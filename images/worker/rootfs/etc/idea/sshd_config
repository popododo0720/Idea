# sshd for the unprivileged "idea" user. Keys only; the authorized key is
# mounted from a Secret that is generated inside the cluster.
Port 2222
ListenAddress 0.0.0.0
HostKey /tmp/idea/ssh/ssh_host_ed25519_key
PidFile /tmp/idea/sshd.pid
AuthorizedKeysFile /etc/idea/authorized_keys/authorized_keys
StrictModes no
UsePAM no
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitRootLogin no
AllowUsers idea
X11Forwarding no
Subsystem sftp internal-sftp
