#!/bin/sh
# Install page, served by the setup extension while it waits for a decision
# (setup.sh): which disk to install to. It only exists before the install,
# on a machine that has no configuration and no data we are allowed to touch
# unasked. The choice is written to /work/choice for setup.sh to pick up.
# Styles come from console/design (copied to /www/design by build-iso.sh).
PATH=/bin
W=/work

esc() { sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g; s/"/\&quot;/g'; }
known() { while read -r dev _; do [ "$dev" = "$1" ] && return 0; done < "$W/disks"; return 1; }
badge() { # used
  if [ "$1" = 1 ]; then echo '<span class="badge badge-warn">has data</span>'; else echo '<span class="badge">empty</span>'; fi
}
plain() { # dev size used model
  if [ "$3" = 1 ]; then s='has data'; else s='empty'; fi
  printf '%s · %s GB · %s%s' "$1" "$2" "$s" "${4:+ · $(echo "$4" | esc)}"
}

head_html() {
  printf 'Content-Type: text/html; charset=utf-8\r\nCache-Control: no-store\r\n\r\n'
  cat <<'HTML'
<!doctype html>
<html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>idea install</title>
<link rel="stylesheet" href="/design/idea.css">
</head><body>
<main class="page-narrow" style="max-width:520px">
<div class="brand" style="margin-bottom:32px"><span class="brand-mark">i</span>idea</div>
HTML
}
foot_html() { echo '</main></body></html>'; }

form() { # form [error]
  head_html
  echo '<div class="stack">'
  echo '<div class="stack-sm"><h1>Choose the install disk</h1>'
  echo '<p class="muted">The chosen disk is wiped entirely and the system is installed on it.</p></div>'
  [ -z "${1:-}" ] || echo "<div class=\"alert alert-bad\"><div>$1</div></div>"
  echo '<form class="stack" method="post" action="/cgi-bin/install">'
  echo '<fieldset style="border:0;margin:0;padding:0"><legend class="label">Disk</legend>'
  while read -r dev size used model; do
    echo "<label class=\"choice\"><input type=\"radio\" name=\"disk\" value=\"$dev\" required>"
    echo "<span class=\"choice-body\"><span class=\"radio-dot\"></span><span class=\"grow\">"
    echo "<span class=\"row\"><strong class=\"mono\">$dev</strong>$(badge "$used")</span>"
    echo "<span class=\"small muted\">${size} GB${model:+ · $(echo "$model" | esc)}</span>"
    echo '</span></span></label>'
  done < "$W/disks"
  echo '</fieldset>'
  if [ "$(grep -c . "$W/disks")" -gt 1 ]; then
    echo '<div class="field"><label class="label" for="data">Disk for data</label>'
    echo '<select class="select" id="data" name="data"><option value="">Keep it on the install disk</option>'
    while read -r dev size used model; do
      echo "<option value=\"$dev\">$(plain "$dev" "$size" "$used" "$model")</option>"
    done < "$W/disks"
    echo '</select><p class="hint">Where the storage and the database live. If you pick a separate disk, that disk is wiped too.</p></div>'
  fi
  echo '<div class="field"><label class="label" for="host">Access name</label>'
  echo '<input class="input mono" id="host" name="host" placeholder="idea.internal" autocomplete="off" autocapitalize="off" spellcheck="false">'
  echo '<p class="hint">The domain name this machine is reached by (for example idea.example.lan). Leave it empty for idea.internal. Point this name at the machine address in DNS or in a hosts file.</p></div>'
  echo '<label class="row small" style="align-items:flex-start;gap:10px;cursor:pointer">'
  echo '<input type="checkbox" name="confirm" value="yes" required style="margin-top:3px">'
  echo '<span>I understand that everything on the chosen disks is erased. This cannot be undone.</span></label>'
  echo '<button class="btn btn-primary btn-block" type="submit">Erase and install</button>'
  echo '</form></div>'
  foot_html
}

started() {
  head_html
  echo '<div class="stack"><div class="stack-sm"><h1>Install started</h1>'
  echo "<p class=\"muted\">Installing to <span class=\"mono\">$(sed -n 1p "$W/choice")</span> and restarting.</p></div>"
  echo '<div class="alert"><div>In about 10 minutes the machine screen shows the setup page address and the setup code. This page is no longer used.</div></div></div>'
  foot_html
}

waiting() {
  head_html
  echo '<div class="stack-sm"><h1>Getting ready</h1><p class="muted">Looking for disks. Refresh in a moment.</p></div>'
  foot_html
}

[ -s "$W/disks" ] || { waiting; exit 0; }
[ ! -s "$W/choice" ] || { started; exit 0; }
[ "${REQUEST_METHOD:-GET}" = POST ] || { form; exit 0; }

len="${CONTENT_LENGTH:-0}"
case "$len" in ''|*[!0-9]*) len=0 ;; esac
[ "$len" -le 2048 ] || len=2048
body="$(head -c "$len")"
field() { echo "$body" | tr '&' '\n' | sed -n "s/^$1=//p" | head -n 1 | sed 's/%2[Ff]/\//g'; }
disk="$(field disk)"; data="$(field data)"; confirm="$(field confirm)"
host="$(field host | tr 'A-Z' 'a-z')"

known "$disk" || { form 'Choose the disk to install to.'; exit 0; }
[ -z "$data" ] || known "$data" || { form 'The data disk is not valid.'; exit 0; }
[ "$data" != "$disk" ] || data=""
[ "$confirm" = yes ] || { form 'Confirm that the disks will be erased before installing.'; exit 0; }
if [ -n "$host" ]; then
  [ "${#host}" -le 253 ] && echo "$host" | grep -Eq '^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)+$' \
    || { form 'The access name is not a valid domain name (for example idea.example.lan).'; exit 0; }
fi

printf '%s\n%s\n%s\n' "$disk" "$data" "$host" > "$W/choice.tmp" && mv "$W/choice.tmp" "$W/choice"
started
