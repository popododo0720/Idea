# Development ISOs only (scripts/build-iso.sh --dev), rendered with values
# from config.env. The public ISO takes DNS from DHCP and pulls from ghcr.io.

# The local registry on the host speaks plain HTTP.
apiVersion: v1alpha1
kind: RegistryMirrorConfig
name: ${REGISTRY_ADDR}
endpoints:
  - url: http://${REGISTRY_ADDR}
---
# Images named ghcr.io/... are looked up in the local registry first (what was
# built on this host); everything else on ghcr.io falls through to the real one.
apiVersion: v1alpha1
kind: RegistryMirrorConfig
name: ghcr.io
endpoints:
  - url: http://${REGISTRY_ADDR}
