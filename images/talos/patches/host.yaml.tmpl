# Rendered by scripts/talos-apply.sh with values from config.env.

# idea-net hands out addresses but no DNS server.
apiVersion: v1alpha1
kind: ResolverConfig
nameservers:
${NAMESERVER_LIST}
---
# The local registry on the host speaks plain HTTP.
apiVersion: v1alpha1
kind: RegistryMirrorConfig
name: ${REGISTRY_ADDR}
endpoints:
  - url: http://${REGISTRY_ADDR}
