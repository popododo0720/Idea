# Copy to ~/.idea-secrets/env (chmod 600). Never put real values in the repo.
# Load into the cluster with scripts/apply-secrets.sh.

# DeepSeek API key for dsh.
DEEPSEEK_API_KEY=

# Optional: long-lived Claude Code token for the Claude Code subagent.
# A human creates it with `claude setup-token` (stage 5d).
CLAUDE_CODE_OAUTH_TOKEN=
